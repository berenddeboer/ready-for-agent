{
  "name": "@ready-for-agent/source",
  "version": "0.0.0",
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "developer-tools",
    "github",
    "gitlab",
    "azure-devops",
    "issue-tracker",
    "pull-request",
    "worktree"
  ],
  "scripts": {
    "commitlint": "commitlint",
    "ready-for-agent": "bun nx run ready-for-agent:run --",
    "knip": "knip --no-config-hints",
    "lint": "biome check .",
    "prepare": "bash scripts/install-git-hooks.sh && effect-tsgo patch && node scripts/fix-bun-typescript-for-nx.mjs"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@berenddeboer/nx-biome": "^1.0.3",
    "@berenddeboer/nx-knip": "^1.1.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "^0.56.0",
    "@nx/js": "24.0.2",
    "@nx/vite": "24.0.2",
    "@swc/helpers": "~0.5.23",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect-solutions": "^0.5.3",
    "keymaxxer": "0.2.2",
    "knip": "^6.43.0",
    "nx": "24.0.2",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "effect": "4.0.6",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@effect/sql-sqlite-bun": "4.0.6"
  }
}
