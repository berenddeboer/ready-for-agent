{
  "name": "@ready-for-agent/source",
  "version": "0.0.0",
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "developer-tools",
    "github",
    "gitlab",
    "issue-tracker",
    "pull-request",
    "worktree"
  ],
  "scripts": {
    "commitlint": "commitlint",
    "ready-for-agent": "bun nx run ready-for-agent:run --",
    "knip": "knip --no-config-hints",
    "lint": "biome check .",
    "prepare": "bash scripts/install-git-hooks.sh && effect-tsgo patch && node scripts/fix-bun-typescript-for-nx.mjs"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@berenddeboer/nx-biome": "^1.0.3",
    "@berenddeboer/nx-knip": "^1.1.0",
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@effect/language-service": "^0.87.1",
    "@effect/tsgo": "^0.24.2",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@swc/helpers": "~0.5.23",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect-solutions": "^0.5.3",
    "keymaxxer": "0.2.2",
    "knip": "^6.32.0",
    "nx": "23.1.1",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "effect": "4.0.0-beta.97",
    "@effect/platform-bun": "4.0.0-beta.97",
    "@effect/vitest": "4.0.0-beta.97",
    "@effect/sql-sqlite-bun": "4.0.0-beta.97"
  }
}
