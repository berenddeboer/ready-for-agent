rfa:WorkItem
  a owl:Class, skos:Concept, rfa:ContextTerm ;
  skos:prefLabel "Work Item"@en ;
  skos:definition "A durable record of one operator-requested attempt to complete a Leaf Issue's objective through the work lifecycle, capturing an Agent Backend as provenance and routing authority, an optional Explicit Work Item Execution Profile, an optional Work Item Auto-merge override, and a durable Merge Mode (ordinary by default). Without an explicit profile, each Agent Turn resolves build and review selections from current backend-scoped Repository settings falling back to Harness Config. With one, the profile's build selection is used for Implement, Review Fix Rounds, Commit, and related steps, while its review selection is used only for reviewing passes inside Review. It references the current Issue by Repository and issue number, captures the Issue title for identification after the Issue leaves the Issue store, records canonical publication title and body after Commit generates them (agent-authored when valid, otherwise harness fallback copy from the Issue identity; shared by git commit and draft PR), records the exact identity of its pull request when one is created, and records the completion summary for a No-Change Outcome. Other Issue contents remain live rather than snapshotted. A Leaf Issue may produce multiple Work Items over time, but at most one may be unfinished at a time."@en ;
  skos:hiddenLabel "Issue lifecycle"@en, "implementation job"@en, "attempt"@en .

[
  a owl:Axiom ;
  owl:annotatedSource rfa:WorkItem ;
  owl:annotatedProperty skos:hiddenLabel ;
  owl:annotatedTarget "Issue lifecycle"@en ;
  rfa:avoidanceRationale "CONTEXT.md prefers Work Item for this concept."@en ;
] .

rfa:ExplicitWorkItemExecutionProfile
  a owl:Class, skos:Concept, rfa:ContextTerm ;
  skos:prefLabel "Explicit Work Item Execution Profile"@en ;
  skos:definition "A durable, immutable override of the Agent Backend, build Agent Model and optional Thinking Level, and review selection used by one Work Item for its entire lifetime. The review selection is either a distinct Agent Model and optional Thinking Level or the durable intent to use exactly the build selection. It does not carry a Work Item Auto-merge override or pause-before-step behavior. Implement With always persists an explicit profile, even when the pre-filled choices are submitted unchanged, without changing Repository settings or Harness Config; ordinary creation has no explicit profile and keeps resolving models from current settings. Retry and Start retain the profile, missing catalog selections fail closed without substitution, and choosing another profile requires Reset followed by a new attempt."@en ;
  skos:hiddenLabel "Issue settings"@en, "per-Issue settings"@en, "model snapshot"@en .

[
  a owl:Axiom ;
  owl:annotatedSource rfa:ExplicitWorkItemExecutionProfile ;
  owl:annotatedProperty skos:hiddenLabel ;
  owl:annotatedTarget "Issue settings"@en ;
  rfa:avoidanceRationale "the selection belongs to one Work Item attempt, not the Issue"@en ;
] .

