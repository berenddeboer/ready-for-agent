  a owl:Class, skos:Concept, rfa:ContextTerm ;
  skos:prefLabel "Implement With"@en ;
  skos:definition "An explicit operator request for an Actionable Issue that chooses an Explicit Work Item Execution Profile plus a concrete Work Item Auto-merge override and an optional Implement Locally inspection pause, then creates the Work Item through the same Worker Slot admission path as Implement Now. Its ephemeral `Implement issue #N with...` dialog is pre-filled from the Repository's effective backend, currently resolved model selections, and live Auto-merge setting; model drafts stay backend-scoped while the two checkboxes stay dialog-wide; Implement Locally starts unchecked. A missing default build model leaves a required blank choice, and a failed backend selection does not disable choosing another backend. It requires a non-empty model catalog; submission atomically revalidates Issue eligibility, activates and inspects the chosen backend when necessary, validates catalog membership and the complete profile, persists the profile, override, and pause target together, and creates nothing on failure. Callers that omit the options keep repository-inherited Auto-merge and the remote path. The dialog has Implement and Cancel actions and ordinary loading and failure feedback, but no recovery, recheck, fallback, or retry workflow. It is offered only as `Implement with...` directly below Implement now in the Issue actions menu and does not change Harness Config or Repository settings."@en ;
  skos:hiddenLabel "Settings"@en, "Implement Locally With"@en, "per-Issue default"@en .

[
  a owl:Axiom ;
  owl:annotatedSource rfa:ImplementWith ;
  owl:annotatedProperty skos:hiddenLabel ;
  owl:annotatedTarget "Settings"@en ;
  rfa:avoidanceRationale "the request creates one Work Item and does not change defaults"@en ;
] .

[
  a owl:Axiom ;
