@prefix example: <https://ready-for-agent.dev/ontology/examples#> .
@prefix rfa: <https://ready-for-agent.dev/ontology/rfa#> .

example:valid-work-item
  a rfa:WorkItem ;
  rfa:currentState rfa:Implement .

example:valid-spec-validation
  a rfa:WorkItem ;
  rfa:workItemOrigin rfa:SpecValidationOrigin ;
  rfa:currentState rfa:ValidateSpec .

example:effective-always
  a rfa:MergeModeAlways, rfa:MergePolicyAlways .
