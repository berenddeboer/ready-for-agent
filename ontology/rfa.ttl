rfa:InvestigateRefreshMergedTransition a rfa:Transition ; rfa:fromStep rfa:InvestigatePrStatusChecks ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_merged_work_item_pr" ; rfa:reasonCode rfa:PrMergedReason .
rfa:MarkReadyRefreshMergedTransition a rfa:Transition ; rfa:fromStep rfa:MarkPrReadyForReview ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_merged_work_item_pr" ; rfa:reasonCode rfa:PrMergedReason .
rfa:DecideRefreshMergedTransition a rfa:Transition ; rfa:fromStep rfa:DecidePrMerge ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_merged_work_item_pr" ; rfa:reasonCode rfa:PrMergedReason .
rfa:MergeRefreshMergedTransition a rfa:Transition ; rfa:fromStep rfa:MergePr ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_merged_work_item_pr" ; rfa:reasonCode rfa:PrMergedReason .
rfa:CloseIssueRefreshMergedTransition a rfa:Transition ; rfa:fromStep rfa:CloseIssue ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_merged_work_item_pr" ; rfa:reasonCode rfa:PrMergedReason .
rfa:NeedsHumanRefreshMergedTransition a rfa:Transition ; rfa:fromStep rfa:NeedsHuman ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_merged_work_item_pr" ; rfa:reasonCode rfa:PrMergedReason .

# Refresh (and Retry/Start on the same parked item) may Complete Attention
# Work Items that do not own a Work Item PR once the Issue is no longer Relevant.
rfa:CreateWorktreeRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:CreateWorktree ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:InstallDependenciesRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:InstallDependencies ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:ImplementRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:Implement ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:AssessChangesRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:AssessChanges ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:PreCommitRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:PreCommit ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:ReviewRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:Review ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:CommitRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:Commit ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:CreatePrRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:CreatePr ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:WatchRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:WatchPrStatusChecks ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:ResolveRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:ResolvePrMergeConflict ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:InvestigateRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:InvestigatePrStatusChecks ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:MarkReadyRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:MarkPrReadyForReview ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:DecideRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:DecidePrMerge ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:MergeRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:MergePr ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:CloseIssueRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:CloseIssue ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .
rfa:NeedsHumanRefreshIssueGoneTransition a rfa:Transition ; rfa:fromStep rfa:NeedsHuman ; rfa:toStep rfa:LocalCleanup ; rfa:guard "refresh_observed_issue_no_longer_relevant_without_owned_pr" ; rfa:reasonCode rfa:NativeReason .

# Refresh may stop pre-cleanup operational work when a competing Issue-closing PR appears.
rfa:CreateWorktreeRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:CreateWorktree ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:InstallDependenciesRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:InstallDependencies ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:ImplementRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:Implement ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:AssessChangesRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:AssessChanges ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:PreCommitRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:PreCommit ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:ReviewRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:Review ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:CommitRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:Commit ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:CreatePrRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:CreatePr ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:WatchRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:WatchPrStatusChecks ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:ResolveRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:ResolvePrMergeConflict ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:InvestigateRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:InvestigatePrStatusChecks ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:MarkReadyRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:MarkPrReadyForReview ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:DecideRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:DecidePrMerge ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:MergeRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:MergePr ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .
rfa:CloseIssueRefreshUnownedClosingPrTransition a rfa:Transition ; rfa:fromStep rfa:CloseIssue ; rfa:toStep rfa:NeedsHuman ; rfa:guard "refresh_observed_unowned_issue_closing_pull_request" ; rfa:reasonCode rfa:NativeReason .

rfa:Complete
  a owl:Class, owl:NamedIndividual, skos:Concept,
    rfa:TerminalWorkItemState ;
  rdfs:subClassOf rfa:TerminalWorkItemState, rfa:CompleteWorkItem ;
  skos:notation "complete" ;
  skos:prefLabel "Complete"@en ;
  skos:definition
    "A terminal Work Item state whose remote outcome and local cleanup have both finished."@en .

rfa:Failed
  a owl:Class, owl:NamedIndividual, skos:Concept,
    rfa:TerminalWorkItemState ;
  rdfs:subClassOf rfa:TerminalWorkItemState, rfa:FailedWorkItem ;
  skos:notation "failed" ;
  skos:prefLabel "Failed"@en ;
  skos:definition
    "A terminal Work Item state that cannot advance because a lifecycle precondition was not met."@en .

rfa:NeedsHuman
  a owl:Class, owl:NamedIndividual, skos:Concept,
    rfa:TerminalWorkItemState ;
  rdfs:subClassOf rfa:TerminalWorkItemState, rfa:NeedsHumanWorkItem ;
  skos:notation "needs_human" ;
  skos:prefLabel "Needs Human"@en ;
  skos:definition
    "A Work Item state that cannot continue autonomously and records the intervention required from a human."@en .

rfa:Abandoned
  a owl:Class, owl:NamedIndividual, skos:Concept,
    rfa:TerminalWorkItemState ;
  rdfs:subClassOf rfa:TerminalWorkItemState ;
  skos:notation "abandoned" ;
  skos:prefLabel "Abandoned"@en ;
  skos:definition
    "A terminal Work Item state that preserves history after the attempt is stopped without completion."@en .

rfa:Paused
  owl:disjointWith rfa:PauseWorkItem .

rfa:InterruptWorkItem
  owl:disjointWith rfa:PauseWorkItem, rfa:Reset .

rfa:WaitingForBlockers
  owl:disjointWith rfa:AdmittedWorkItem .

rfa:MergePolicyOff
  a owl:Class ;
  rdfs:subClassOf rfa:MergePolicy ;
  owl:disjointWith rfa:MergePolicyClassify, rfa:MergePolicyAlways .

rfa:MergePolicyClassify
  a owl:Class ;
  rdfs:subClassOf rfa:MergePolicy ;
  owl:disjointWith rfa:MergePolicyAlways .

rfa:MergePolicyAlways
  a owl:Class ;
  rdfs:subClassOf rfa:MergePolicy ;
  owl:equivalentClass rfa:MergeModeAlways .

rfa:MergeModeAlways
  a owl:Class ;
  rdfs:subClassOf rfa:MergeMode ;
  owl:equivalentClass rfa:MergePolicyAlways .

rfa:StepRun
  rdfs:subClassOf
    prov:Activity,
    [
      a owl:Restriction ;
      owl:onProperty prov:wasAssociatedWith ;
      owl:someValuesFrom rfa:Harness ;
    ] .

rfa:AgentTurn
  rdfs:subClassOf
    prov:Activity,
    [
      a owl:Restriction ;
      owl:onProperty prov:wasAssociatedWith ;
      owl:someValuesFrom rfa:AgentBackend ;
    ] .

rfa:InteractiveSessionContinuation
  rdfs:subClassOf
    prov:Activity,
    [
      a owl:Restriction ;
      owl:onProperty prov:wasAssociatedWith ;
      owl:someValuesFrom rfa:AgentBackend ;
    ] .

rfa:AgentBackend
  rdfs:subClassOf prov:SoftwareAgent .

rfa:Operator
  a owl:Class ;
  rdfs:subClassOf prov:Person .

rfa:Harness
  a owl:Class ;
  rdfs:subClassOf prov:SoftwareAgent .

rfa:Outcome
  a owl:Class ;
  rdfs:subClassOf prov:Entity .

rfa:AgentAttributedOutcome
  a owl:Class ;
  rdfs:subClassOf
    rfa:Outcome,
    [
      a owl:Restriction ;
      owl:onProperty prov:wasAttributedTo ;
      owl:someValuesFrom rfa:AgentBackend ;
    ] .

rfa:HarnessAttributedOutcome
  a owl:Class ;
  rdfs:subClassOf
    rfa:Outcome,
    [
      a owl:Restriction ;
      owl:onProperty prov:wasAttributedTo ;
      owl:someValuesFrom rfa:Harness ;
    ] .

rfa:AgentReportedOutcome
  rdfs:subClassOf rfa:AgentAttributedOutcome .

rfa:NoChangeOutcome
  rdfs:subClassOf rfa:AgentReportedOutcome .

rfa:AcceptedReviewOutcome
  rdfs:subClassOf rfa:AgentReportedOutcome .

rfa:ClearedReviewOutcome
  rdfs:subClassOf rfa:AgentReportedOutcome .

rfa:ChecksTriggeredOutcome
  rdfs:subClassOf rfa:AgentReportedOutcome .

rfa:MergeRevalidationOutcome
  rdfs:subClassOf rfa:HarnessAttributedOutcome .

rfa:AgentTurnResult
  rdfs:subClassOf
    prov:Entity,
    [
      a owl:Restriction ;
      owl:onProperty prov:wasGeneratedBy ;
      owl:someValuesFrom rfa:AgentTurn ;
    ] .

[
  a owl:AllDisjointClasses ;
  owl:members (
    rfa:Complete
    rfa:Failed
    rfa:NeedsHuman
    rfa:Abandoned
  )
] .

[
  a owl:AllDisjointClasses ;
  owl:members (
    rfa:CreateWorktree
    rfa:InstallDependencies
    rfa:Implement
    rfa:AssessChanges
    rfa:PreCommit
    rfa:Review
    rfa:Commit
    rfa:CreatePr
    rfa:WatchPrStatusChecks
    rfa:ResolvePrMergeConflict
    rfa:InvestigatePrStatusChecks
    rfa:MarkPrReadyForReview
    rfa:DecidePrMerge
    rfa:MergePr
    rfa:CloseIssue
    rfa:LocalCleanup
    rfa:Complete
    rfa:Failed
    rfa:NeedsHuman
    rfa:Abandoned
  )
] .
