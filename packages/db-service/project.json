{
  "name": "db-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --build tsconfig.lib.json --force"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun test"
      },
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["^build"]
    }
  }
}
