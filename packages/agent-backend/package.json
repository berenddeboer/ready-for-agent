{
  "name": "@ready-for-agent/agent-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@ready-for-agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": {
      "@ready-for-agent/source": "./src/lib/registry.ts",
      "types": "./dist/lib/registry.d.ts",
      "import": "./dist/lib/registry.js",
      "default": "./dist/lib/registry.js"
    }
  },
  "dependencies": {
    "@ready-for-agent/lifecycle-model": "workspace:*",
    "effect": "4.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.6",
    "@types/bun": "^1.4.4"
  }
}
