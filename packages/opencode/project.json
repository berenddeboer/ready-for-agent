{
  "name": "opencode",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/opencode/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions=@ready-for-agent/source test --path-ignore-patterns '**/v2-cli-contract.spec.ts'"
      },
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "cli-contract": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions=@ready-for-agent/source ../../scripts/run-opencode-cli-contract.ts"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/mise.toml",
        "{workspaceRoot}/scripts/install-opencode-v2.sh",
        "{workspaceRoot}/scripts/opencode-contract-gate.ts",
        "{workspaceRoot}/scripts/run-opencode-cli-contract.ts",
        "{workspaceRoot}/apps/ready-for-agent/src/**/*.ts",
        "{workspaceRoot}/.github/workflows/pr.yml",
        "{workspaceRoot}/.github/workflows/ci-cd.yml",
        "{workspaceRoot}/.github/workflows/opencode-cli-contract-drift.yml"
      ],
      "cache": false
    }
  }
}
