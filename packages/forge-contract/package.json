{
  "name": "@ready-for-agent/forge-contract",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@ready-for-agent/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ci-gate-incident-history": {
      "@ready-for-agent/source": "./src/lib/ci-gate-incident-history.ts",
      "types": "./dist/lib/ci-gate-incident-history.d.ts",
      "import": "./dist/lib/ci-gate-incident-history.js",
      "default": "./dist/lib/ci-gate-incident-history.js"
    },
    "./ci-gate-run": {
      "@ready-for-agent/source": "./src/lib/ci-gate-run.ts",
      "types": "./dist/lib/ci-gate-run.d.ts",
      "import": "./dist/lib/ci-gate-run.js",
      "default": "./dist/lib/ci-gate-run.js"
    }
  },
  "dependencies": {
    "@ready-for-agent/lifecycle-model": "workspace:*",
    "effect": "4.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
