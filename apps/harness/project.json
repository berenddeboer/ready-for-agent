{
  "name": "harness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "dependsOn": [
        "^build",
        {
          "projects": ["graphql-schema", "db"],
          "target": "generate"
        },
        {
          "projects": ["ready-for-agent"],
          "target": "generate-version"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/ready-for-agent/package.json",
        "{projectRoot}/src/generated/version.ts"
      ]
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "ROOT=\"$(cd ../.. && pwd)\" && mkdir -p \"$ROOT/tmp\" && export SQLITE_DATABASE_PATH=\"${SQLITE_DATABASE_PATH:-$ROOT/tmp/ready-for-agent.db}\" && bun --conditions @ready-for-agent/source ../../scripts/run-with-keymaxxer-sidecar.ts bun --conditions @ready-for-agent/source src/server/run-dev.ts",
        "cwd": "apps/harness"
      },
      "dependsOn": [
        "db:migrate",
        {
          "projects": ["graphql-client", "github-service", "graphql-schema"],
          "target": "generate"
        }
      ]
    },
    "serve": {
      "dependsOn": [
        {
          "projects": ["graphql-client", "github-service", "graphql-schema"],
          "target": "generate"
        }
      ]
    },
    "start": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "ROOT=\"$(cd ../.. && pwd)\" && mkdir -p \"$ROOT/tmp\" && export SQLITE_DATABASE_PATH=\"${SQLITE_DATABASE_PATH:-$ROOT/tmp/ready-for-agent.db}\" && bun --conditions @ready-for-agent/source server.ts",
        "cwd": "apps/harness"
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/run-unit-tests.sh",
        "env": {
          "KEYMAXXER_ENABLED": "false"
        }
      },
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "slow-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --bun ./node_modules/vitest/vitest.mjs run --config vitest.config.ts test/production-sse-idle-timeout.test.ts",
        "env": {
          "KEYMAXXER_ENABLED": "false"
        }
      },
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bddgen && playwright test --grep-invert @no-backend"
      },
      "dependsOn": [
        "build",
        {
          "projects": ["graphql-client"],
          "target": "generate"
        }
      ]
    },
    "e2e-no-vault": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source test test/keymaxxer-uninitialized-e2e.test.ts"
      },
      "inputs": ["default", "^production"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "e2e-no-backend": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bddgen && playwright test --grep @no-backend",
        "env": {
          "E2E_AGENT_BACKEND_MODE": "no-opencode",
          "KEYMAXXER_ENABLED": "false",
          "E2E_KEYMAXXER_MASTER_KEY": "",
          "KEYMAXXER_MASTER_KEY": ""
        }
      },
      "dependsOn": [
        "build",
        {
          "projects": ["graphql-client"],
          "target": "generate"
        }
      ]
    },
    "e2e-live-forge": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bddgen && playwright test --grep @live-forge"
      },
      "dependsOn": [
        "build",
        {
          "projects": ["graphql-client"],
          "target": "generate"
        }
      ]
    },
    "e2e-ui-history": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bddgen && playwright test --grep @ui-history",
        "env": {
          "KEYMAXXER_ENABLED": "false",
          "E2E_KEYMAXXER_MASTER_KEY": "",
          "KEYMAXXER_MASTER_KEY": "",
          "E2E_HARNESS_WORKERS": "2"
        }
      },
      "dependsOn": [
        "build",
        {
          "projects": ["graphql-client"],
          "target": "generate"
        }
      ]
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/dev-smoke.ts",
        "env": {
          "KEYMAXXER_ENABLED": "false"
        }
      },
      "dependsOn": [
        "db:migrate",
        {
          "projects": ["graphql-client", "github-service", "graphql-schema"],
          "target": "generate"
        }
      ]
    }
  }
}
