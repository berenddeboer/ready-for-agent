{
  "name": "ready-for-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ready-for-agent/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["graphql-client"],
          "target": "generate"
        },
        "generate-embed"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source src/main.ts"
      }
    },
    "generate-version": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/write-ready-for-agent-version.ts"
      },
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/scripts/write-ready-for-agent-version.ts"
      ],
      "outputs": [
        "{projectRoot}/src/generated/version.ts",
        "{workspaceRoot}/apps/harness/src/generated/version.ts"
      ],
      "cache": true
    },
    "generate-embed": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["harness"],
          "target": "build"
        },
        {
          "projects": ["db", "graphql-schema"],
          "target": "generate"
        },
        "generate-version"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/generate-standalone-embed.ts"
      },
      "inputs": [
        {
          "dependentTasksOutputFiles": "**/dist/client/**/*",
          "transitive": false
        },
        "{projectRoot}/package.json",
        "{projectRoot}/scripts/generate-standalone-embed.ts",
        "{projectRoot}/scripts/write-ready-for-agent-version.ts"
      ],
      "outputs": [
        "{projectRoot}/src/generated",
        "{workspaceRoot}/apps/harness/src/generated/version.ts"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["generate-embed"]
    },
    "compile": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["graphql-client"],
          "target": "generate"
        },
        "generate-embed"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/compile-platform-binary.ts {args.platform}",
        "args": "--platform=host"
      },
      "inputs": ["default", "^production"],
      "outputs": [
        "{workspaceRoot}/packages/ready-for-agent-linux-x64/bin",
        "{workspaceRoot}/packages/ready-for-agent-linux-arm64/bin",
        "{workspaceRoot}/packages/ready-for-agent-darwin-x64/bin",
        "{workspaceRoot}/packages/ready-for-agent-darwin-arm64/bin",
        "{workspaceRoot}/packages/ready-for-agent-win32-x64/bin",
        "{workspaceRoot}/packages/ready-for-agent-win32-arm64/bin"
      ],
      "cache": false
    },
    "lint-usage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "bash scripts/run-pinned-usage.sh lint --warnings-as-errors apps/ready-for-agent/ready-for-agent.usage.kdl"
      },
      "inputs": [
        "{projectRoot}/ready-for-agent.usage.kdl",
        "{workspaceRoot}/scripts/run-pinned-usage.sh",
        "{workspaceRoot}/mise.toml"
      ],
      "cache": true
    },
    "update-usage-docs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/update-usage-docs.ts"
      },
      "inputs": [
        "{projectRoot}/ready-for-agent.usage.kdl",
        "{projectRoot}/scripts/update-usage-docs.ts",
        "{workspaceRoot}/scripts/run-pinned-usage.sh",
        "{workspaceRoot}/mise.toml",
        "{workspaceRoot}/README.md"
      ],
      "outputs": ["{workspaceRoot}/README.md"],
      "cache": false
    },
    "check-usage-docs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/update-usage-docs.ts --check"
      },
      "inputs": [
        "{projectRoot}/ready-for-agent.usage.kdl",
        "{projectRoot}/scripts/update-usage-docs.ts",
        "{workspaceRoot}/scripts/run-pinned-usage.sh",
        "{workspaceRoot}/mise.toml",
        "{workspaceRoot}/README.md"
      ],
      "cache": true
    },
    "generate-usage-completions": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/generate-usage-completions.ts {args.shell}",
        "args": "--shell=bash"
      },
      "inputs": [
        "{projectRoot}/scripts/generate-usage-completions.ts",
        "{workspaceRoot}/scripts/run-pinned-usage.sh",
        "{workspaceRoot}/mise.toml"
      ],
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/run-unit-tests.sh"
      },
      "inputs": ["default", "^production", "{workspaceRoot}/README.md"],
      "cache": true,
      "dependsOn": [
        {
          "projects": ["graphql-client"],
          "target": "generate"
        },
        "generate-embed",
        "lint-usage",
        "check-usage-docs"
      ]
    },
    "packed-install-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/packed-install-smoke.ts {args}"
      },
      "cache": false
    },
    "overnight-published-install-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun --conditions @ready-for-agent/source scripts/overnight-published-install-smoke.ts {args}"
      },
      "cache": false
    }
  }
}
